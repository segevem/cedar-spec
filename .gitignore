# Don't check in the local metadata file.
.DS_Store

# Don't check in ide settings by accident
.idea
.kiro
.claude
# VSCode settings -- although we have some checked in, we don't want local
# settings to appear as unstaged changes by default
.vscode

# Don't check in the Emacs temp files
*~

# Don't check in test framework files
.attach_pid*

# Don't check IntelliJ module files
*.iml

# Rust build artifacts
**/target
**/Cargo.lock
cedar-drt/fuzz/corpus
cedar-drt/fuzz/artifacts



# We expect a copy of `cedar-policy/cedar` present in this directory, but do
# not track it in version control.
cedar/
!cedar-lean/Cedar

# LLVM coverage raw profiles (regenerable intermediates)
*.profraw

# --- regenerable build & experiment artifacts (do not track) ---
target_cov*/
target_sancov/
exp_*/
corpus*/
repeated_results/
coverage_results*/
crash_dump/
dumped_tests*/
kept_examples/
pruned_examples/
validation_dump*/
fuzz_binary/
# compiled fuzz binary that sits inside coverage/ (dir-only rule above misses the file)
cedar-drt/coverage/fuzz_binary

# Root symlink to the sibling cedar checkout — do not commit as a dangling link
/cedar

# Local-only redaction map (real values behind pushed placeholders); never push
.redaction-map.local.md
